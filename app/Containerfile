FROM python:3.12-slim

# CIS Benchmark L2: run as non-root user.
RUN groupadd --gid 1001 appuser \
    && useradd --uid 1001 --gid appuser --shell /bin/bash --create-home appuser

USER appuser

WORKDIR /home/appuser/app

# Ensure user-local bin (pip-installed scripts) is on PATH.
# Required because we install as non-root into ~/.local/bin.
ENV PATH="/home/appuser/.local/bin:${PATH}"

# Copy package metadata AND source together so setuptools can resolve
# [tool.setuptools.packages.find] where = ["src"] during the wheel build.
COPY --chown=appuser:appuser pyproject.toml .
COPY --chown=appuser:appuser src/ ./src/

# Upgrade pip then install the package runtime dependencies only (no dev tools).
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir .

# Copy runtime assets needed by the application.
COPY --chown=appuser:appuser base-template/ ./base-template/

# Create the generated-apps output directory owned by the runtime user.
RUN mkdir -p generated-apps

EXPOSE 8000

# Health check — polls the /health endpoint every 30 s.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
